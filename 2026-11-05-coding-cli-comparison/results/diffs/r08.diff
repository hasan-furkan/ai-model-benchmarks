+import threading
+import time
 import unittest
+from collections.abc import MutableMapping
 
 from inventory import InventoryService
+
+
+class SlowStore(MutableMapping):
+    """Cache-like mapping whose reads and writes are slow.
+
+    The production store is cache-backed and slow; the delay widens the
+    read-modify-write window so that a missing lock would oversell.
+    """
+
+    def __init__(self, data, delay=0.001):
+        self._data = dict(data)
+        self._delay = delay
+
+    def __getitem__(self, key):
+        time.sleep(self._delay)
+        return self._data[key]
+
+    def __setitem__(self, key, value):
+        time.sleep(self._delay)
+        self._data[key] = value
+
+    def __delitem__(self, key):
+        del self._data[key]
+
+    def __iter__(self):
+        return iter(self._data)
+
+    def __len__(self):
+        return len(self._data)
 
 
 class InventoryTest(unittest.TestCase):
