+def get_orders(query):
+    raw = query.get("customer_id")
+    if raw is None:
+        return error(400, "customer_id is required")
+    if not raw.isdigit():
+        return error(400, "customer_id must be a number")
+    customer_id = int(raw)
+    # Timestamps carry different UTC offsets, so compare absolute instants (aware
+    # datetimes compare across offsets correctly) rather than local wall time.
+    rows = sorted(
+        (o for o in db.ORDERS if o["customer_id"] == customer_id),
+        key=lambda o: o["created_at"].astimezone(timezone.utc),
+        reverse=True,
+    )
+    return 200, [
+        {"id": o["id"], "total": money(o["total"]), "created_at": iso_utc(o["created_at"])}
+        for o in rows
+    ]
+
