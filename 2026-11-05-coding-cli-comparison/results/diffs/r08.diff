+    def _race_reserves(self, stock, thread_count):
+        store = SlowStore({"apple": stock})
+        svc = InventoryService(store)
+        barrier = threading.Barrier(thread_count)
+        results = []
+        errors = []
+
+        def worker():
+            try:
+                barrier.wait()
+                results.append(svc.reserve("apple", 1))
+            except BaseException as exc:  # surfaced below, never swallowed
+                errors.append(exc)
+
+        threads = [threading.Thread(target=worker) for _ in range(thread_count)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+        return svc, store, results, errors
+
+    def test_last_unit_is_reserved_by_exactly_one_thread(self):
+        # Regression test for the reported flash-sale oversell: one shared
+        # service, many web threads, a slow cache-backed store.
+        thread_count = 16
+        svc, store, results, errors = self._race_reserves(1, thread_count)
+
+        self.assertEqual(errors, [])
+        self.assertEqual(len(results), thread_count)
+        self.assertEqual(sum(results), 1)
+        self.assertEqual(store["apple"], 0)
+        self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_reservations_never_exceed_stock(self):
+        thread_count = 16
+        svc, store, results, errors = self._race_reserves(3, thread_count)
+
+        self.assertEqual(errors, [])
+        self.assertEqual(len(results), thread_count)
+        self.assertEqual(sum(results), 3)
+        self.assertEqual(store["apple"], 0)
+        self.assertEqual(svc.available("apple"), 0)
+
 
