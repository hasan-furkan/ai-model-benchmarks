+class _SlowStore(dict):
+    """Stand-in for the slow, cache-backed production store.
+
+    The latency inside reads and writes widens the window between the
+    stock check and the write in InventoryService.reserve(), which is
+    exactly where an unsynchronised implementation oversells.
+    """
+
+    delay = 0.001
+
+    def __getitem__(self, key):
+        value = super().__getitem__(key)
+        time.sleep(self.delay)
+        return value
+
+    def __setitem__(self, key, value):
+        time.sleep(self.delay)
+        super().__setitem__(key, value)
+
+
+class InventoryConcurrencyTest(unittest.TestCase):
+    """The service is shared by all web-server threads, so reserve() must be atomic."""
+
+    @staticmethod
+    def _race(svc, n_threads, attempts=1):
+        """Start `n_threads` threads together and return every reserve() result."""
+        results = []
+        guard = threading.Lock()
+        barrier = threading.Barrier(n_threads)
+
+        def worker():
+            barrier.wait(timeout=10)
+            for _ in range(attempts):
+                ok = svc.reserve("apple", 1)
+                with guard:
+                    results.append(ok)
+
+        threads = [threading.Thread(target=worker) for _ in range(n_threads)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+        return results
+
+    def test_two_threads_cannot_both_take_the_last_unit(self):
+        for _ in range(5):
+            svc = InventoryService(_SlowStore({"apple": 1}))
+            results = self._race(svc, n_threads=2)
+            self.assertEqual(sum(results), 1, results)
+            self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_reserve_on_slow_store_never_oversells(self):
+        for _ in range(5):
+            svc = InventoryService(_SlowStore({"apple": 4}))
+            results = self._race(svc, n_threads=8)
+            self.assertEqual(sum(results), 4, results)
+            self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_reserve_and_release_preserve_stock(self):
+        svc = InventoryService({"apple": 20})
+        accepted = 0
+        released = 0
+        guard = threading.Lock()
+        n_threads = 6
+        barrier = threading.Barrier(n_threads)
+
+        def worker(seed):
+            nonlocal accepted, released
+            rng = random.Random(seed)
+            barrier.wait(timeout=10)
+            for _ in range(100):
+                if rng.random() < 0.6:
+                    if svc.reserve("apple", 1):
+                        with guard:
+                            accepted += 1
+                else:
+                    svc.release("apple", 1)
+                    with guard:
+                        released += 1
+
+        threads = [threading.Thread(target=worker, args=(seed,)) for seed in range(n_threads)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        remaining = svc.available("apple")
+        self.assertGreaterEqual(remaining, 0)
+        self.assertEqual(remaining, 20 - accepted + released)
+
+
 if __name__ == "__main__":
     unittest.main()