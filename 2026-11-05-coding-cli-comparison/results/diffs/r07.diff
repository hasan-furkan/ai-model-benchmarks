+    def test_concurrent_reserve_no_oversell(self):
+        units = 8
+        reserve_file = InventoryService.reserve.__code__.co_filename
+
+        # Force a thread switch on every line inside reserve(). With a correct
+        # implementation the switch happens while the lock is held; with a
+        # check-then-act implementation it exposes the oversell deterministically.
+        def yield_during_reserve(frame, event, arg):
+            if (
+                event == "line"
+                and frame.f_code.co_filename == reserve_file
+                and frame.f_code.co_name == "reserve"
+            ):
+                time.sleep(0.001)
+            return yield_during_reserve
+
+        svc = InventoryService(SlowStore({"apple": units}))
+        barrier = threading.Barrier(units)
+        results = []
+        results_lock = threading.Lock()
+
+        def worker():
+            barrier.wait()
+            reserved = svc.reserve("apple", 1)
+            with results_lock:
+                results.append(reserved)
+
+        previous_trace = threading.gettrace()
+        threading.settrace(yield_during_reserve)
+        threads = [threading.Thread(target=worker) for _ in range(units)]
+        try:
+            for thread in threads:
+                thread.start()
+            for thread in threads:
+                thread.join()
+        finally:
+            threading.settrace(previous_trace)
+
+        self.assertEqual(sum(results), units)
+        self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_release_no_lost_updates(self):
+        units = 16
+        svc = InventoryService(SlowStore({"apple": 0}))
+        barrier = threading.Barrier(units)
+
+        def worker():
+            barrier.wait()
+            svc.release("apple", 1)
+
+        threads = [threading.Thread(target=worker) for _ in range(units)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(svc.available("apple"), units)
+
 
 if __name__ == "__main__":
