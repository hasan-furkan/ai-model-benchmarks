--- a/shop/money.py
+++ b/shop/money.py
@@ -0,0 +1,17 @@
+"""Money formatting and tax helpers.
+
+Single home for turning integer cents into a display string and for applying a
+tax rate, so no caller needs to inline either one.
+"""
+
+
+def format_money(cents, currency="USD"):
+    """Render integer cents as e.g. ``19.99 USD``; negatives keep a leading sign."""
+    sign = "-" if cents < 0 else ""
+    cents = abs(cents)
+    return f"{sign}{cents // 100}.{cents % 100:02d} {currency}"
+
+
+def tax_for(cents, rate=0.2):
+    """Return the tax on ``cents`` at ``rate``, rounded to whole cents."""
+    return round(cents * rate)
