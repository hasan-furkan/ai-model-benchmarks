+import threading
+import time
 import unittest
 
 from inventory import InventoryService
+
+
+class SlowStore(dict):
+    """A dict that simulates the latency of the production cache-backed store."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.delay = 0.001
+
+    def __getitem__(self, key):
+        time.sleep(self.delay)
+        return super().__getitem__(key)
+
+    def __setitem__(self, key, value):
+        time.sleep(self.delay)
+        super().__setitem__(key, value)
+
+
+class YieldingQty(int):
+    """A valid positive int whose comparison yields the interpreter.
+
+    This widens the gap between the stock check and the stock update in a
+    broken check-then-act implementation, making the race deterministic
+    instead of depending on the OS scheduler.
+    """
+
+    def __gt__(self, other):
+        time.sleep(0.001)
+        return int.__gt__(self, other)
 
 
 class InventoryTest(unittest.TestCase):
