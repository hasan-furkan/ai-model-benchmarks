+class OrdersTest(unittest.TestCase):
+    def test_orders_are_newest_first_with_utc_and_money(self):
+        status, body = handle("GET", "/orders", {"customer_id": "1"})
+        self.assertEqual(status, 200)
+        self.assertEqual(
+            body,
+            [
+                {"id": 102, "total": "5.00", "created_at": "2026-10-27T11:00:00Z"},
+                {"id": 101, "total": "19.90", "created_at": "2026-10-19T22:30:00Z"},
+            ],
+        )
+
+    def test_only_requested_customers_orders(self):
+        status, body = handle("GET", "/orders", {"customer_id": "3"})
+        self.assertEqual(status, 200)
+        self.assertEqual([o["id"] for o in body], [103])
+
+    def test_customer_without_orders_is_empty_200(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "2"}), (200, []))
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "99"}), (200, []))
+
+    def test_missing_customer_id_is_400(self):
+        status, body = handle("GET", "/orders", {})
+        self.assertEqual(status, 400)
+        self.assertIn("error", body)
+
+    def test_bad_customer_id_is_400(self):
+        for raw in ("abc", "", "-1", "1.0", "1 2"):
+            self.assertEqual(handle("GET", "/orders", {"customer_id": raw})[0], 400, raw)
+
+    def test_orders_method_not_allowed(self):
+        self.assertEqual(handle("POST", "/orders", {"customer_id": "1"})[0], 405)
+
+
