+import sys
+import threading
 import unittest
 
 from inventory import InventoryService
+
+# The races below live in the handful of bytecodes between a lock release and
+# the next lock acquisition, so they only show up when the GIL is handed over
+# often. A short switch interval makes the interleaving reproducible instead of
+# relying on luck; the previous value is restored after every test.
+SWITCH_INTERVAL = 1e-6
+
+
+def run_threads(target, count):
+    """Run `target` in `count` threads released at the same instant."""
+    barrier = threading.Barrier(count)
+
+    def wrapped():
+        barrier.wait()
+        target()
+
+    threads = [threading.Thread(target=wrapped) for _ in range(count)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
 
 
 class InventoryTest(unittest.TestCase):
     def setUp(self):
         self.svc = InventoryService({"apple": 5})
+        self._switch_interval = sys.getswitchinterval()
+        sys.setswitchinterval(SWITCH_INTERVAL)
+
+    def tearDown(self):
+        sys.setswitchinterval(self._switch_interval)
 
