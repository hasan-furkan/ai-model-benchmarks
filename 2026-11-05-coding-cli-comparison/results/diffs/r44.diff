-        # Weeks start on Sunday.
-        week = day - timedelta(days=(day.weekday() + 1) % 7)
-        amount = abs(int(row["amount_cents"]))
+        if row["status"] == "voided":
+            continue
+        amount = int(row["amount_cents"])
