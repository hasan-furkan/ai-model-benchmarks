+def get_orders(query):
+    raw = query.get("customer_id")
+    if raw is None or raw == "":
+        return error(400, "customer_id is required")
+    try:
+        customer_id = int(str(raw).strip())
+    except ValueError:
+        return error(400, "customer_id must be a number")
+    if not any(c["id"] == customer_id for c in db.CUSTOMERS):
+        return error(404, "customer not found")
+    # Timestamps carry different UTC offsets (summer/winter), so sort by the
+    # actual instant; aware datetimes compare correctly across offsets.
+    orders = sorted(
+        (o for o in db.ORDERS if o["customer_id"] == customer_id),
+        key=lambda o: (o["created_at"], o["id"]),
+        reverse=True,
+    )
+    return 200, [
+        {"id": o["id"], "total": money(o["total"]), "created_at": iso_utc(o["created_at"])}
+        for o in orders
+    ]
+
