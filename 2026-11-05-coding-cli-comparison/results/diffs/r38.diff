+import threading
+import time
 import unittest
 
 from inventory import InventoryService
+
+
+class SlowMapping(dict):
+    """Stand-in for the production cache-backed store: every access has latency.
+
+    The sleep gives the interpreter a chance to switch threads in the middle of
+    a read-modify-write, which is exactly where an unlocked reserve() oversells.
+    """
+
+    delay = 0.0005
+
+    def __getitem__(self, key):
+        value = dict.__getitem__(self, key)
+        time.sleep(self.delay)
+        return value
+
+    def __setitem__(self, key, value):
+        time.sleep(self.delay)
+        dict.__setitem__(self, key, value)
+
+
+def _run_threads(count, target):
+    barrier = threading.Barrier(count)
+    threads = []
+
+    def worker():
+        barrier.wait()
+        target()
+
+    for _ in range(count):
+        thread = threading.Thread(target=worker)
+        threads.append(thread)
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
 
 
