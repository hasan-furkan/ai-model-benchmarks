+import threading
+import time
 import unittest
 
 from inventory import InventoryService
+
+
+class SlowStore(dict):
+    """Mapping with deliberately slow reads and writes, like the production cache."""
+
+    def __getitem__(self, sku):
+        time.sleep(0.001)
+        return super().__getitem__(sku)
+
+    def __setitem__(self, sku, value):
+        time.sleep(0.001)
+        super().__setitem__(sku, value)
 
 
 class InventoryTest(unittest.TestCase):
