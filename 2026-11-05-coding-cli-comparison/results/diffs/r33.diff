+import sys
+import threading
+import time
 import unittest
 
 from inventory import InventoryService
+
+
+class SlowStore(dict):
+    """Cache-backed style mapping: reads and writes take real time.
+
+    Production uses a slow cache-backed mapping, so a read followed by a write
+    is a long window for another thread to read the same stale value.
+    """
+
+    def __init__(self, *args, delay=0.001, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.delay = delay
+
+    def __getitem__(self, key):
+        value = super().__getitem__(key)
+        time.sleep(self.delay)
+        return value
+
+    def __setitem__(self, key, value):
+        time.sleep(self.delay)
+        super().__setitem__(key, value)
 
 
 class InventoryTest(unittest.TestCase):
