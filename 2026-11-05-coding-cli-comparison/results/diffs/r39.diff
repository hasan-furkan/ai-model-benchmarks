+    def test_concurrent_reserve_no_oversell(self):
+        stock = 10
+        workers = 25
+        svc = InventoryService(SlowStore({"apple": stock}))
+        barrier = threading.Barrier(workers)
+        results = []
+        results_lock = threading.Lock()
+
+        def buy_one():
+            barrier.wait()
+            reserved = svc.reserve("apple", 1)
+            with results_lock:
+                results.append(reserved)
+
+        tracer = LineYieldTracer(InventoryService.reserve.__code__.co_filename)
+        threading.settrace(tracer)
+        try:
+            threads = [threading.Thread(target=buy_one) for _ in range(workers)]
+            for thread in threads:
+                thread.start()
+            for thread in threads:
+                thread.join()
+        finally:
+            threading.settrace(None)
+
+        self.assertEqual(len(results), workers)
+        self.assertEqual(sum(1 for reserved in results if reserved), stock)
+        self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_release_no_lost_updates(self):
+        workers = 20
+        svc = InventoryService(SlowStore({"apple": 0}))
+        barrier = threading.Barrier(workers)
+
+        def give_one_back():
+            barrier.wait()
+            svc.release("apple", 1)
+
+        threads = [threading.Thread(target=give_one_back) for _ in range(workers)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(svc.available("apple"), workers)
+
 
