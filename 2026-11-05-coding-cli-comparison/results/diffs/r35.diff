+import threading
+import time
 import unittest
 
 from inventory import InventoryService
+
+
+class SlowStore(dict):
+    """Mimics the production cache-backed mapping: every access pays a delay.
+
+    The delay widens any read-modify-write race window, so a service that is
+    not properly serialized will oversell under this store.
+    """
+
+    delay = 0.0005
+
+    def __getitem__(self, key):
+        time.sleep(self.delay)
+        return super().__getitem__(key)
+
+    def __setitem__(self, key, value):
+        time.sleep(self.delay)
+        super().__setitem__(key, value)
 
 
 class InventoryTest(unittest.TestCase):
