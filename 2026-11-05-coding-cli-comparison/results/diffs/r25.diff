+def get_orders(query):
+    raw = query.get("customer_id")
+    if raw is None or raw == "":
+        return error(400, "customer_id is required")
+    if not isinstance(raw, str) or not (raw.isascii() and raw.isdigit()):
+        return error(400, "customer id must be a number")
+    customer_id = int(raw)
+    if not any(c["id"] == customer_id for c in db.CUSTOMERS):
+        return error(404, "customer not found")
+    rows = [o for o in db.ORDERS if o["customer_id"] == customer_id]
+    # Compare instants, not local wall-clock strings: the shops' timestamps mix
+    # summer (UTC+2) and winter (UTC+1) offsets, so naive ordering can be wrong.
+    rows.sort(key=lambda o: o["created_at"], reverse=True)
+    return 200, [
+        {"id": o["id"], "total": money(o["total"]), "created_at": iso_utc(o["created_at"])}
+        for o in rows
+    ]
