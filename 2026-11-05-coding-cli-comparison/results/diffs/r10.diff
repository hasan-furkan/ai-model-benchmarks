+class SlowStore(dict):
+    """Dict that mimics the slow, cache-backed production mapping."""
+
+    def __getitem__(self, key):
+        time.sleep(0.001)
+        return super().__getitem__(key)
+
+    def __setitem__(self, key, value):
+        time.sleep(0.001)
+        return super().__setitem__(key, value)
 
 
