+    def test_concurrent_reserve_no_oversell(self):
+        initial = 20
+        attempts = 50
+        svc = InventoryService(SlowStore({"apple": initial}))
+        start = threading.Barrier(attempts)
+        results = []
+        results_lock = threading.Lock()
+
+        def worker():
+            start.wait()
+            reserved = svc.reserve("apple", YieldingQty(1))
+            with results_lock:
+                results.append(reserved)
+
+        threads = [threading.Thread(target=worker) for _ in range(attempts)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(sum(results), initial)
+        self.assertEqual(len(results), attempts)
+        self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_release_no_lost_updates(self):
+        releases = 50
+        svc = InventoryService(SlowStore({"apple": 0}))
+        start = threading.Barrier(releases)
+
+        def worker():
+            start.wait()
+            svc.release("apple", 1)
+
+        threads = [threading.Thread(target=worker) for _ in range(releases)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(svc.available("apple"), releases)
+
 
 if __name__ == "__main__":
