+import threading
+import time
 import unittest
 
 from inventory import InventoryService
+
+
+class SlowStore(dict):
+    """Dict with slow accesses, standing in for the production cache-backed mapping."""
+
+    delay = 0.0005
+
+    def __getitem__(self, key):
+        time.sleep(self.delay)
+        return super().__getitem__(key)
+
+    def __setitem__(self, key, value):
+        time.sleep(self.delay)
+        super().__setitem__(key, value)
+
+
+class LineYieldTracer:
+    """Yield the GIL at every source line of the service module.
+
+    A racy check-then-write is a tiny window that normal thread scheduling
+    usually misses, which would make the regression test pass by luck.
+    Pausing on each line of the service module forces the scheduler to run
+    other threads between the stock read and the stock write, so the test
+    fails deterministically against a non-atomic implementation and still
+    passes against an atomic one.
+    """
+
+    def __init__(self, filename: str, pause: float = 0.0002):
+        self._filename = filename
+        self._pause = pause
+
+    def __call__(self, frame, event, arg):
+        if frame.f_code.co_filename != self._filename:
+            return None
+        return self._trace
+
+    def _trace(self, frame, event, arg):
+        if event == "line":
+            time.sleep(self._pause)
+        return self._trace
 
 
 class InventoryTest(unittest.TestCase):
