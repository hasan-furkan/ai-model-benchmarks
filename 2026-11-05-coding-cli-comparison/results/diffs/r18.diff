+import threading
+import time
 import unittest
+from collections.abc import MutableMapping
 
 from inventory import InventoryService
+
+
+class SlowStore(MutableMapping):
+    """Stand-in for the production cache-backed mapping.
+
+    Every access is deliberately slow, which widens the window between the
+    read and the write of a read-modify-write sequence and makes races
+    reproducible instead of luck-dependent.
+    """
+
+    def __init__(self, data=None, delay=0.001):
+        self._data = dict(data or {})
+        self._delay = delay
+
+    def __getitem__(self, key):
+        time.sleep(self._delay)
+        return self._data[key]
+
+    def __setitem__(self, key, value):
+        time.sleep(self._delay)
+        self._data[key] = value
+
+    def __delitem__(self, key):
+        time.sleep(self._delay)
+        del self._data[key]
+
+    def __iter__(self):
+        return iter(list(self._data))
+
+    def __len__(self):
+        return len(self._data)
+
+
+class PreemptibleInt(int):
+    """An int that briefly yields the GIL when compared.
+
+    Simulates the worker thread being preempted (or waiting on the slow cache)
+    between the "is there enough stock?" check and the write that follows it.
+    """
+
+    def __gt__(self, other):
+        time.sleep(0.002)
+        return int.__gt__(self, other)
+
+
+def run_concurrently(target, count):
+    """Start `count` threads that all begin together; return their exceptions."""
+    start = threading.Barrier(count)
+    errors = []
+
+    def wrapper():
+        try:
+            start.wait(timeout=10)
+            target()
+        except BaseException as exc:  # pragma: no cover - only on failure
+            errors.append(exc)
+
+    threads = [threading.Thread(target=wrapper) for _ in range(count)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+    return errors
 
 
 class InventoryTest(unittest.TestCase):
