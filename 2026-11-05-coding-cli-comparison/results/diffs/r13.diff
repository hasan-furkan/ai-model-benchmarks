+def _utc_date(value):
+    """Return the date of an ISO 8601 timestamp in UTC.
+
+    Timestamps without an offset are interpreted as UTC.  Reporting is always
+    done on the UTC calendar, regardless of the offset carried by the input.
+    """
+    moment = datetime.fromisoformat(value)
+    if moment.tzinfo is None:
+        return moment.date()
+    return moment.astimezone(timezone.utc).date()
+
+
+def _week_start(day):
+    """Return the Monday that starts ``day``'s reporting week."""
+    return day - timedelta(days=day.weekday())
 
 
