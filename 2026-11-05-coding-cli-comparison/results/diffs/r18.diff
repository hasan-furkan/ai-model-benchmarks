+    def test_concurrent_reserve_no_oversell(self):
+        """Flash sale: many threads race for the last units of one SKU."""
+        buyers = 32
+        units = 8
+        store = SlowStore({"apple": units})
+        svc = InventoryService(store)
+
+        sold = []
+        sold_lock = threading.Lock()
+
+        def buy():
+            ok = svc.reserve("apple", PreemptibleInt(1))
+            with sold_lock:
+                sold.append(ok)
+
+        errors = run_concurrently(buy, buyers)
+
+        self.assertEqual(errors, [])
+        self.assertEqual(sum(1 for ok in sold if ok), units, "oversold or undersold")
+        self.assertEqual(svc.available("apple"), 0)
+        self.assertGreaterEqual(store["apple"], 0)
+
+    def test_concurrent_release_no_lost_update(self):
+        """Cancellations: concurrent releases must not overwrite each other."""
+        cancellations = 20
+        store = SlowStore({"apple": 0})
+        svc = InventoryService(store)
+
+        errors = run_concurrently(lambda: svc.release("apple", 1), cancellations)
+
+        self.assertEqual(errors, [])
+        self.assertEqual(svc.available("apple"), cancellations)
+
 
 if __name__ == "__main__":
