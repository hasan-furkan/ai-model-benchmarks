+import threading
+import time
 import unittest
+from collections.abc import MutableMapping
 
 from inventory import InventoryService
+
+
+class SlowCacheStore(MutableMapping):
+    """Stand-in for the production cache-backed store: every access has latency.
+
+    A slow mapping widens the read-modify-write window, which is exactly what
+    makes a lock-free `reserve()` oversell under thread contention.
+    """
+
+    def __init__(self, initial):
+        self._data = dict(initial)
+
+    def __getitem__(self, key):
+        time.sleep(0.0002)
+        return self._data[key]
+
+    def __setitem__(self, key, value):
+        time.sleep(0.0002)
+        self._data[key] = value
+
+    def __delitem__(self, key):
+        del self._data[key]
+
+    def __iter__(self):
+        return iter(self._data)
+
+    def __len__(self):
+        return len(self._data)
+
+
+def _run_threads(target, count):
+    """Start `count` threads that all call `target(index)` at the same moment."""
+    barrier = threading.Barrier(count)
+
+    def run(index):
+        barrier.wait()
+        target(index)
+
+    threads = [threading.Thread(target=run, args=(i,)) for i in range(count)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
 
 
