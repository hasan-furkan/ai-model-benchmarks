+class OrdersTest(unittest.TestCase):
+    def test_orders_are_newest_first_with_utc_and_money_strings(self):
+        status, body = handle("GET", "/orders", {"customer_id": "1"})
+        self.assertEqual(status, 200)
+        self.assertEqual(
+            body,
+            [
+                {"id": 102, "total": "5.00", "created_at": "2026-10-27T11:00:00Z"},
+                {"id": 101, "total": "19.90", "created_at": "2026-10-19T22:30:00Z"},
+            ],
+        )
+
+    def test_newest_first_compares_absolute_utc_time_not_local_time(self):
+        original = db.ORDERS
+        db.ORDERS = [
+            {"id": 1, "customer_id": 7, "total": Decimal("1"),
+             "created_at": datetime(2026, 10, 20, 0, 30, tzinfo=db.WARSAW_SUMMER)},
+            {"id": 2, "customer_id": 7, "total": Decimal("2"),
+             "created_at": datetime(2026, 10, 19, 23, 45, tzinfo=db.WARSAW_WINTER)},
+        ]
+        try:
+            status, body = handle("GET", "/orders", {"customer_id": "7"})
+        finally:
+            db.ORDERS = original
+        self.assertEqual(status, 200)
+        # 23:45+01:00 is 22:45Z, later than 00:30+02:00 (22:30Z), despite
+        # looking earlier when only the local wall-clock time is considered.
+        self.assertEqual([o["id"] for o in body], [2, 1])
+
+    def test_unknown_customer_has_no_orders(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "99"}), (200, []))
+
+    def test_existing_customer_without_orders_has_empty_list(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "2"}), (200, []))
+
+    def test_missing_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {})[0], 400)
+
+    def test_bad_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "abc"})[0], 400)
+
+    def test_non_get_is_405(self):
+        self.assertEqual(handle("POST", "/orders", {"customer_id": "1"})[0], 405)
+
+
 if __name__ == "__main__":
     unittest.main()