+import threading
+import time
 import unittest
+from collections.abc import MutableMapping
 
 from inventory import InventoryService
+
+
+class SlowStore(MutableMapping):
+    """Stand-in for the production cache-backed mapping.
+
+    Every access has noticeable latency, which widens any window between a
+    read and the matching write.
+    """
+
+    def __init__(self, data, read_delay=0.002, write_delay=0.002):
+        self._data = dict(data)
+        self._read_delay = read_delay
+        self._write_delay = write_delay
+        self._store_lock = threading.Lock()
+
+    def __getitem__(self, key):
+        time.sleep(self._read_delay)
+        with self._store_lock:
+            return self._data[key]
+
+    def __setitem__(self, key, value):
+        time.sleep(self._write_delay)
+        with self._store_lock:
+            self._data[key] = value
+
+    def __delitem__(self, key):
+        with self._store_lock:
+            del self._data[key]
+
+    def __iter__(self):
+        with self._store_lock:
+            return iter(list(self._data))
+
+    def __len__(self):
+        with self._store_lock:
+            return len(self._data)
+
+
+class TicketLock:
+    """FIFO mutex for the reservation regression test.
+
+    A thread that releases the lock and immediately tries to take it again
+    queues behind every thread already waiting. That mimics an unlucky
+    thread switch on a busy server and exposes non-atomic check-then-write
+    code deterministically.
+    """
+
+    def __init__(self):
+        self._condition = threading.Condition(threading.Lock())
+        self._next_ticket = 0
+        self._now_serving = 0
+
+    def acquire(self):
+        with self._condition:
+            ticket = self._next_ticket
+            self._next_ticket += 1
+            while ticket != self._now_serving:
+                self._condition.wait()
+
+    def release(self):
+        with self._condition:
+            self._now_serving += 1
+            self._condition.notify_all()
+
+    def __enter__(self):
+        self.acquire()
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.release()
 
 
