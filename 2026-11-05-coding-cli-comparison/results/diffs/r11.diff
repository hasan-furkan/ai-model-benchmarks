+    def test_concurrent_reserve_no_oversell(self):
+        stock = 5
+        buyers = 20
+        svc = ContextSwitchInventoryService(SlowMapping({"apple": stock}))
+        barrier = threading.Barrier(buyers)
+        results = []
+        results_lock = threading.Lock()
+
+        def buy():
+            barrier.wait()
+            reserved = svc.reserve("apple", 1)
+            with results_lock:
+                results.append(reserved)
+
+        threads = [threading.Thread(target=buy) for _ in range(buyers)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(results.count(True), stock)
+        self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_release_no_lost_updates(self):
+        savers = 10
+        svc = InventoryService(SlowMapping({"apple": 0}))
+        barrier = threading.Barrier(savers)
+
+        def give_back():
+            barrier.wait()
+            svc.release("apple", 1)
+
+        threads = [threading.Thread(target=give_back) for _ in range(savers)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(svc.available("apple"), savers)
+
 
