+    def test_concurrent_reserve_no_oversell(self):
+        stock = 10
+        workers = 40
+        rounds = 25
+        old_interval = sys.getswitchinterval()
+        # Tiny switch interval forces preemption between the stock read and the
+        # write, which is where the check-then-act race hides.
+        sys.setswitchinterval(1e-6)
+        try:
+            for round_no in range(rounds):
+                svc = InventoryService({"apple": stock})
+                start = threading.Barrier(workers)
+                results = []
+                results_lock = threading.Lock()
+
+                def worker():
+                    start.wait()
+                    granted = svc.reserve("apple", 1)
+                    with results_lock:
+                        results.append(granted)
+
+                threads = [threading.Thread(target=worker) for _ in range(workers)]
+                for thread in threads:
+                    thread.start()
+                for thread in threads:
+                    thread.join()
+
+                granted = sum(1 for ok in results if ok)
+                self.assertEqual(len(results), workers)
+                self.assertLessEqual(
+                    granted, stock, f"round {round_no}: sold {granted} of {stock} units"
+                )
+                self.assertEqual(
+                    svc.available("apple"),
+                    stock - granted,
+                    f"round {round_no}: stock count drifted from granted reservations",
+                )
+                self.assertEqual(granted, stock, f"round {round_no}: stock was not fully sold")
+        finally:
+            sys.setswitchinterval(old_interval)
+
+    def test_concurrent_release_keeps_count(self):
+        stock = 100
+        svc = InventoryService(SlowStore({"apple": 0}))
+        workers = 20
+        start = threading.Barrier(workers)
+
+        def worker():
+            start.wait()
+            for _ in range(5):
+                svc.release("apple", 1)
+
+        threads = [threading.Thread(target=worker) for _ in range(workers)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(svc.available("apple"), workers * 5)
+
 
