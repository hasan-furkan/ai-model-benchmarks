+class OrdersTest(unittest.TestCase):
+    def test_orders_are_newest_first_with_money_and_utc_strings(self):
+        status, body = handle("GET", "/orders", {"customer_id": "1"})
+        self.assertEqual(status, 200)
+        self.assertEqual([o["id"] for o in body], [102, 101])
+        self.assertEqual(
+            body[0],
+            {"id": 102, "total": "5.00", "created_at": "2026-10-27T11:00:00Z"},
+        )
+        self.assertEqual(
+            body[1],
+            {"id": 101, "total": "19.90", "created_at": "2026-10-19T22:30:00Z"},
+        )
+
+    def test_response_has_only_the_documented_fields(self):
+        _, body = handle("GET", "/orders", {"customer_id": "1"})
+        for order in body:
+            self.assertEqual(set(order), {"id", "total", "created_at"})
+
+    def test_only_the_requested_customer_is_returned(self):
+        status, body = handle("GET", "/orders", {"customer_id": "3"})
+        self.assertEqual(status, 200)
+        self.assertEqual(body, [{"id": 103, "total": "120.00", "created_at": "2026-09-01T06:15:00Z"}])
+
+    def test_customer_without_orders_is_empty_200(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "2"}), (200, []))
+
+    def test_unknown_customer_is_empty_200(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "99"}), (200, []))
+
+    def test_missing_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {})[0], 400)
+
+    def test_non_numeric_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "abc"})[0], 400)
+
+    def test_negative_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "-1"})[0], 400)
+
+    def test_only_get_is_allowed(self):
+        self.assertEqual(handle("POST", "/orders", {"customer_id": "1"})[0], 405)
+
+
+class OrdersSortingTest(unittest.TestCase):
+    def test_sorted_by_instant_not_by_id_or_wall_clock(self):
+        # By id and by wall-clock text 900 would come first, but its instant is
+        # earlier than 100's, so only comparing aware datetimes gets this right.
+        original = db.ORDERS
+        try:
+            db.ORDERS = [
+                {"id": 900, "customer_id": 7, "total": Decimal("1"),
+                 "created_at": datetime(2026, 10, 20, 0, 30, tzinfo=timezone(timedelta(hours=2)))},
+                {"id": 100, "customer_id": 7, "total": Decimal("2"),
+                 "created_at": datetime(2026, 10, 19, 23, 0, tzinfo=timezone(timedelta(hours=-5)))},
+            ]
+            status, body = handle("GET", "/orders", {"customer_id": "7"})
+        finally:
+            db.ORDERS = original
+        self.assertEqual(status, 200)
+        self.assertEqual([o["id"] for o in body], [100, 900])
+
+
