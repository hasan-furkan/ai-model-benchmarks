+def get_orders(customer_id):
+    rows = [o for o in db.ORDERS if o["customer_id"] == customer_id]
+    # Compare the timezone-aware datetimes themselves: stored offsets vary
+    # (Europe/Warsaw summer vs winter), so raw wall-clock values can misorder.
+    rows.sort(key=lambda o: (o["created_at"], o["id"]), reverse=True)
+    return 200, [
+        {"id": o["id"], "total": money(o["total"]), "created_at": iso_utc(o["created_at"])}
+        for o in rows
+    ]
+
