+def _utc_week_start(created_at):
+    """Return the Monday (UTC) of the week containing an ISO 8601 timestamp.
+
+    Timestamps carrying an offset are converted to UTC first; timestamps
+    without an offset are treated as UTC already.
+    """
+    moment = datetime.fromisoformat(created_at)
+    if moment.tzinfo is not None:
+        moment = moment.astimezone(timezone.utc)
+    day = moment.date()
+    return day - timedelta(days=day.weekday())
 
 
