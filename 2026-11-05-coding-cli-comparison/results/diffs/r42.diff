+def _utc_day(created_at):
+    """Return the UTC calendar date of an ISO 8601 timestamp.
+
+    Offsets are honoured; a timestamp without an offset is read as UTC.
+    """
+    stamp = datetime.fromisoformat(created_at.strip())
+    if stamp.tzinfo is None:
+        stamp = stamp.replace(tzinfo=timezone.utc)
+    return stamp.astimezone(timezone.utc).date()
+
+
+def _week_start(day):
+    """Monday-based reporting week containing ``day``."""
+    return day - timedelta(days=day.weekday())
 
 
