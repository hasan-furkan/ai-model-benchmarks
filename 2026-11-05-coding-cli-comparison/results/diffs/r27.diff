+class OrdersTest(unittest.TestCase):
+    def test_orders_newest_first_with_utc_and_money_strings(self):
+        status, body = handle("GET", "/orders", {"customer_id": "1"})
+        self.assertEqual(status, 200)
+        self.assertEqual(
+            body,
+            [
+                {"id": 102, "total": "5.00", "created_at": "2026-10-27T11:00:00Z"},
+                {"id": 101, "total": "19.90", "created_at": "2026-10-19T22:30:00Z"},
+            ],
+        )
+
+    def test_orders_only_returns_that_customers_rows(self):
+        status, body = handle("GET", "/orders", {"customer_id": "3"})
+        self.assertEqual(status, 200)
+        self.assertEqual([o["id"] for o in body], [103])
+
+    def test_orders_exclude_other_customers(self):
+        status, body = handle("GET", "/orders", {"customer_id": "2"})
+        self.assertEqual(status, 200)
+        self.assertEqual(body, [])
+
+    def test_orders_missing_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {})[0], 400)
+
+    def test_orders_bad_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "abc"})[0], 400)
+
+    def test_orders_unknown_customer_is_404(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "99"}), (404, {"error": "customer not found"}))
+
+    def test_orders_is_get_only(self):
+        self.assertEqual(handle("POST", "/orders", {"customer_id": "1"})[0], 405)
