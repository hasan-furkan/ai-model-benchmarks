+def get_orders(query):
+    raw = query.get("customer_id")
+    if raw is None or not raw.isdigit():
+        return error(400, "customer id must be a number")
+    customer_id = int(raw)
+    rows = sorted(
+        (o for o in db.ORDERS if o["customer_id"] == customer_id),
+        key=lambda o: o["created_at"],
+        reverse=True,
+    )
+    return 200, [
+        {"id": o["id"], "total": money(o["total"]), "created_at": iso_utc(o["created_at"])}
+        for o in rows
+    ]
+
