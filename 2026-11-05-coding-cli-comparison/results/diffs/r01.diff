+def _utc_day(value):
+    """Return the UTC calendar date for an ISO 8601 timestamp."""
+    # ``fromisoformat`` accepts a trailing ``Z`` on Python 3.11, but normalise
+    # it explicitly so the behaviour is unambiguous.
+    text = value.strip()
+    if text.endswith(("Z", "z")):
+        text = text[:-1] + "+00:00"
+    moment = datetime.fromisoformat(text)
+    if moment.tzinfo is None:
+        # A timestamp without an offset is treated as UTC.
+        moment = moment.replace(tzinfo=timezone.utc)
+    else:
+        moment = moment.astimezone(timezone.utc)
+    return moment.date()
+
+
+def _week_start(day):
+    """Return the Monday that starts the reporting week containing ``day``."""
+    return day - timedelta(days=day.weekday())
 
 
