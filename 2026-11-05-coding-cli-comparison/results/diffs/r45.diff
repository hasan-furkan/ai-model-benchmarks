+def get_orders(query):
+    raw = query.get("customer_id")
+    if raw is None:
+        return error(400, "customer_id is required")
+    raw = str(raw)
+    if not raw.isdigit():
+        return error(400, "customer id must be a number")
+    customer_id = int(raw)
+    rows = [o for o in db.ORDERS if o["customer_id"] == customer_id]
+    rows.sort(key=lambda o: o["created_at"], reverse=True)
+    return 200, [
+        {"id": o["id"], "total": money(o["total"]), "created_at": iso_utc(o["created_at"])}
+        for o in rows
+    ]
+
