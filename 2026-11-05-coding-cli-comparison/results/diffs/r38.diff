+class ConcurrentReserveTest(unittest.TestCase):
+    """Regression tests for the reported flash-sale overselling.
+
+    reserve() reads and writes the store, so the whole read-modify-write has to
+    happen under one lock. These tests force thread switches inside the store
+    access (a slow cache-backed mapping) and require that stock is never
+    oversold and never lost.
+    """
+
+    def test_last_unit_is_sold_exactly_once(self):
+        for _ in range(50):
+            store = SlowMapping({"apple": 1})
+            svc = InventoryService(store)
+            results = []
+            lock = threading.Lock()
+
+            def target():
+                granted = svc.reserve("apple", 1)
+                with lock:
+                    results.append(granted)
+
+            _run_threads(8, target)
+
+            self.assertEqual(sum(results), 1, "last unit was sold more than once")
+            self.assertEqual(len(results), 8)
+            self.assertEqual(store["apple"], 0)
+
+    def test_total_stock_is_never_exceeded(self):
+        store = SlowMapping({"apple": 10})
+        svc = InventoryService(store)
+        granted = []
+        lock = threading.Lock()
+
+        def target():
+            ok = svc.reserve("apple", 1)
+            with lock:
+                if ok:
+                    granted.append(1)
+
+        _run_threads(25, target)
+
+        self.assertEqual(len(granted), 10)
+        self.assertEqual(store["apple"], 0)
+
+    def test_concurrent_reserve_and_release_conserve_stock(self):
+        store = SlowMapping({"apple": 3})
+        svc = InventoryService(store)
+
+        def target():
+            if svc.reserve("apple", 1):
+                svc.release("apple", 1)
+
+        _run_threads(12, target)
+
+        self.assertEqual(store["apple"], 3)
+        self.assertEqual(svc.available("apple"), 3)
+
+
 if __name__ == "__main__":
     unittest.main()