+    def test_concurrent_reserve_last_unit_only_once(self):
+        """All threads race for the last unit; exactly one may win."""
+        thread_count = 24
+        store = SlowStore({"apple": 1})
+        svc = InventoryService(store)
+        barrier = threading.Barrier(thread_count, timeout=10)
+        results = [None] * thread_count
+
+        def worker(index):
+            barrier.wait()
+            results[index] = svc.reserve("apple", 1)
+
+        threads = [threading.Thread(target=worker, args=(i,)) for i in range(thread_count)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(sum(results), 1)
+        self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_reserve_never_oversells(self):
+        """Concurrent reservations cannot sell more units than are in stock."""
+        stock = 10
+        thread_count = 40
+        store = SlowStore({"apple": stock})
+        svc = InventoryService(store)
+        barrier = threading.Barrier(thread_count, timeout=10)
+        results = [None] * thread_count
+
+        def worker(index):
+            barrier.wait()
+            results[index] = svc.reserve("apple", 1)
+
+        threads = [threading.Thread(target=worker, args=(i,)) for i in range(thread_count)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(sum(results), stock)
+        self.assertEqual(svc.available("apple"), 0)
+
 
