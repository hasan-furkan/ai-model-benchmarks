+    def test_concurrent_reserve_no_oversell(self):
+        """More buyers than units: the units sold must never exceed the stock."""
+        stock = 1000
+        workers = 20
+        attempts_per_worker = 100  # 2000 attempts for 1000 units
+        svc = InventoryService({"apple": stock})
+        sold = []
+        sold_lock = threading.Lock()
+
+        def sell():
+            mine = 0
+            for _ in range(attempts_per_worker):
+                if svc.reserve("apple", 1):
+                    mine += 1
+            with sold_lock:
+                sold.append(mine)
+
+        run_threads(sell, workers)
+
+        self.assertEqual(sum(sold), stock, "units sold must equal the stock")
+        self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_release_no_drift(self):
+        """Concurrent cancellations must all be counted, none overwritten."""
+        workers = 20
+        releases_per_worker = 50
+        svc = InventoryService({"apple": 0})
+
+        def cancel():
+            for _ in range(releases_per_worker):
+                svc.release("apple", 1)
+
+        run_threads(cancel, workers)
+
+        self.assertEqual(svc.available("apple"), workers * releases_per_worker)
+
 
 if __name__ == "__main__":
     unittest.main()