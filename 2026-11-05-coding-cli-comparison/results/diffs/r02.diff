+"""Weekly revenue report.
+
+Rules implemented here come from docs/finance-rules.md:
+  1. A reporting week starts on Monday and is computed in UTC, whatever
+     offset the timestamp carries.
+  2. Rows with status ``voided`` never count.
+  3. A refund (negative ``amount_cents`` with ``refund_of`` pointing at the
+     original sale id) reduces the week of the original sale, not the week
+     the refund itself happened in.
+  4. If the original sale is not in the data set, the refund reduces the
+     week of the refund row itself.
+"""
 import csv
-from datetime import datetime, timedelta
+from datetime import datetime, timedelta, timezone
+
+VOIDED = "voided"
+
+
+def _utc_date(value):
+    """Parse an ISO 8601 timestamp and return its date in UTC.
+
+    A timestamp without an offset is taken to be UTC already: the rule says
+    weeks are computed in UTC, and treating a naive value as local time would
+    make the result depend on the machine's time zone.
+    """
+    moment = datetime.fromisoformat(value.strip())
+    if moment.tzinfo is None:
+        moment = moment.replace(tzinfo=timezone.utc)
+    return moment.astimezone(timezone.utc).date()
+
+
+def _week_start(day):
+    """Return the Monday that starts the reporting week containing *day*."""
+    return day - timedelta(days=day.weekday())
+
+
+def _is_voided(row):
+    return (row.get("status") or "").strip().lower() == VOIDED
+
+
+def _amount(row):
+    return int(str(row["amount_cents"]).strip())
 
 
