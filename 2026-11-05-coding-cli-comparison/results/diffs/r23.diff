--- a/shop/money.py
+++ b/shop/money.py
@@ -0,0 +1,15 @@
+"""Money formatting and tax calculation."""
+
+DEFAULT_TAX_RATE = 0.2
+
+
+def format_money(cents, currency="USD"):
+    """Render an integer amount of cents as e.g. ``-12.34 USD``."""
+    sign = "-" if cents < 0 else ""
+    cents = abs(cents)
+    return f"{sign}{cents // 100}.{cents % 100:02d} {currency}"
+
+
+def tax_for(cents, rate=DEFAULT_TAX_RATE):
+    """Return the tax owed on ``cents`` at ``rate``, rounded to whole cents."""
+    return round(cents * rate)
