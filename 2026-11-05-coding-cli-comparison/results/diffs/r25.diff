@@ -0,0 +1,71 @@
+import unittest
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+from unittest.mock import patch
+
+import db
+from app import handle
+
+WARSAW_WINTER = timezone(timedelta(hours=1))
+WARSAW_SUMMER = timezone(timedelta(hours=2))
+
+
+class OrdersTest(unittest.TestCase):
+    def test_customer_orders_newest_first_with_utc_and_money(self):
+        status, body = handle("GET", "/orders", {"customer_id": "1"})
+        self.assertEqual(status, 200)
+        self.assertEqual(
+            body,
+            [
+                {"id": 102, "total": "5.00", "created_at": "2026-10-27T11:00:00Z"},
+                {"id": 101, "total": "19.90", "created_at": "2026-10-19T22:30:00Z"},
+            ],
+        )
+
+    def test_only_requested_customer_orders(self):
+        status, body = handle("GET", "/orders", {"customer_id": "3"})
+        self.assertEqual(status, 200)
+        self.assertEqual([o["id"] for o in body], [103])
+
+    def test_customer_without_orders_is_empty_200(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "2"}), (200, []))
+
+    def test_response_fields_are_exactly_id_total_created_at(self):
+        status, body = handle("GET", "/orders", {"customer_id": "1"})
+        self.assertEqual(status, 200)
+        for order in body:
+            self.assertEqual(set(order), {"id", "total", "created_at"})
+
+    def test_ordering_uses_instants_not_local_wall_clock(self):
+        # Local wall clock puts 201 (Oct 27 00:30 +02:00) after 202 (Oct 26 23:50 +01:00),
+        # but in UTC 202 is later (22:50Z vs 22:30Z), so 202 must come first.
+        rows = [
+            {"id": 201, "customer_id": 1, "total": Decimal("1"), "created_at": datetime(2026, 10, 27, 0, 30, tzinfo=WARSAW_SUMMER)},
+            {"id": 202, "customer_id": 1, "total": Decimal("2"), "created_at": datetime(2026, 10, 26, 23, 50, tzinfo=WARSAW_WINTER)},
+        ]
+        with patch.object(db, "ORDERS", rows):
+            status, body = handle("GET", "/orders", {"customer_id": "1"})
+        self.assertEqual(status, 200)
+        self.assertEqual([o["id"] for o in body], [202, 201])
+        self.assertEqual(body[0]["created_at"], "2026-10-26T22:50:00Z")
+
+    def test_missing_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {})[0], 400)
+
+    def test_empty_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": ""})[0], 400)
+
+    def test_non_numeric_customer_id_is_400(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "abc"})[0], 400)
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "1.5"})[0], 400)
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "-1"})[0], 400)
+
+    def test_unknown_customer_is_404(self):
+        self.assertEqual(handle("GET", "/orders", {"customer_id": "99"}), (404, {"error": "customer not found"}))
+
+    def test_other_methods_are_405(self):
+        self.assertEqual(handle("POST", "/orders", {"customer_id": "1"})[0], 405)
+
+
+if __name__ == "__main__":
+    unittest.main()