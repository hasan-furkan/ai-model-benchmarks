+import threading
+import time
 import unittest
 
 from inventory import InventoryService
+
+
+class SlowMapping(dict):
+    """A dict that yields on every access, like the slow cache-backed
+    production store, so a racing implementation has a wide window."""
+
+    def __init__(self, *args, delay=0.001, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.delay = delay
+
+    def __getitem__(self, key):
+        value = super().__getitem__(key)
+        time.sleep(self.delay)
+        return value
+
+    def __setitem__(self, key, value):
+        time.sleep(self.delay)
+        super().__setitem__(key, value)
+
+
+class ContextSwitchLock:
+    """Mutex that hands the CPU to another worker whenever it is released.
+
+    A loaded web server preempts a worker right after it leaves a critical
+    section. Doing that explicitly makes the race deterministic instead of
+    depending on the OS scheduler, so the regression test fails every time
+    on a non-atomic read-modify-write.
+    """
+
+    def __init__(self):
+        self._lock = threading.Lock()
+
+    def __enter__(self):
+        self._lock.acquire()
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self._lock.release()
+        time.sleep(0.005)
+        return False
+
+
+class ContextSwitchInventoryService(InventoryService):
+    """InventoryService whose lock allows a thread switch on release."""
+
+    def __init__(self, store):
+        super().__init__(store)
+        self._lock = ContextSwitchLock()
 
 
 class InventoryTest(unittest.TestCase):
