+    def test_concurrent_reserve_no_oversell(self):
+        initial_stock = 20
+        workers = 40
+        # The slow read gives every worker time to queue on the FIFO lock
+        # before the first reservation can proceed to its write.
+        svc = InventoryService(
+            SlowStore({"apple": initial_stock}, read_delay=0.01, write_delay=0.001)
+        )
+        svc._lock = TicketLock()
+        start = threading.Barrier(workers)
+        successes = []
+        successes_lock = threading.Lock()
+
+        def buy():
+            start.wait()
+            if svc.reserve("apple", 1):
+                with successes_lock:
+                    successes.append(1)
+
+        threads = [threading.Thread(target=buy) for _ in range(workers)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        # Exactly the units that existed can be sold; none may be sold twice.
+        self.assertEqual(len(successes), initial_stock)
+        self.assertEqual(svc.available("apple"), 0)
+
+    def test_concurrent_release_no_lost_updates(self):
+        initial_stock = 100
+        workers = 20
+        svc = InventoryService(SlowStore({"apple": initial_stock}))
+        start = threading.Barrier(workers)
+
+        def cancel():
+            start.wait()
+            svc.release("apple", 1)
+
+        threads = [threading.Thread(target=cancel) for _ in range(workers)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(svc.available("apple"), initial_stock + workers)
+
 
